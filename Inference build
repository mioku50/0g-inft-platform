console.log('[CHAT] prepared - Checking wallet availability...')  
console.log('[CHAT] fetch - Sending to chat API...')
console.log('[CHAT] HIT - Request prepared successfully')
console.log('[PROXY] HIT - Forwarding to proxy endpoint')
