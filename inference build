Enhanced provider interaction to handle "ServiceNotExist" errors gracefully:

try {
  const meta = await broker.inference.getServiceMetadata(service.provider)
  metadata = { endpoint: meta.endpoint, model: meta.model }
} catch (metaErr: any) {
