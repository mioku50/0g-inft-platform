{
  "name": "0g-inft-platform",
  "version": "1.0.0",
  "description": "Decentralized AI Agent NFT Platform on 0G Network",
  "private": true,
  "scripts": {
    "setup": "bash scripts/quick-start.sh",
    "generate-wallets": "node scripts/generate-wallets.js",
    "dev": "cd web && npm run dev",
    "build": "cd web && npm run build",
    "deploy:contracts": "cd contracts && npm run deploy:testnet",
    "test:contracts": "cd contracts && npm test",
    "install:all": "npm run install:web && npm run install:contracts",
    "install:web": "cd web && npm install",
    "install:contracts": "cd contracts && npm install",
    "clean": "npm run clean:web && npm run clean:contracts",
    "clean:web": "cd web && rm -rf .next node_modules/.cache",
    "clean:contracts": "cd contracts && rm -rf cache artifacts",
    "check:health": "curl http://localhost:3000/api/storage/health | jq",
    "check:env": "node scripts/check-env.js"
    ,"e2e:fine-tune": "pnpm --filter ./web run e2e:fine-tune"
  },
  "keywords": [
    "0g",
    "nft",
    "ai",
    "blockchain",
    "web3"
  ],
  "author": "0G INFT Team",
  "license": "MIT",
  "devDependencies": {
    "ethers": "^6.0.0"
  }
}