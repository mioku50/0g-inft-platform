# Required Environment Variables for 0G Fine-tuning

# 0G Network Configuration
NEXT_PUBLIC_0G_RPC_URL=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_0G_CHAIN_ID=16601

# 0G Storage Configuration
NEXT_PUBLIC_0G_STORAGE_URL=https://indexer-storage-testnet-turbo.0g.ai
NEXT_PUBLIC_0G_FLOW_ADDRESS=0xbD75117F80b4E22698D0Cd7612d92BDb8eaff628

# Private Keys (Server-side only - keep secure!)
OG_COMPUTE_PRIVATE_KEY=your_private_key_here_without_0x_prefix
OG_STORAGE_PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Fine-tuning Contracts (Galileo Testnet v3)
NEXT_PUBLIC_FINE_TUNING_SERVING_ADDRESS=0xda478Ccf5d534346A16b1475E4c2DecE0268B176
NEXT_PUBLIC_COMPUTE_LEDGER_CONTRACT=0x1a85Dd32da10c170F4f138d082DDc496ab3E5BAa
NEXT_PUBLIC_COMPUTE_INFERENCE_CONTRACT=0x5299bd255B76305ae08d7F95B270A485c6b95D54

# Agent Model Registry Contract (To be deployed)
NEXT_PUBLIC_AGENT_MODEL_REGISTRY_ADDRESS=your_agent_model_registry_contract_address

# Fine-tuning Providers
NEXT_PUBLIC_FINE_TUNE_PROVIDER=0xf07240Efa67755B5311bc75784a061eDB47165Dd
FINE_TUNE_PROVIDER=0xf07240Efa67755B5311bc75784a061eDB47165Dd

# WalletConnect (for wallet connection)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Fine-tuning Feature Flag (set to 0 for real SDK calls, 1 for mocks)
FT_MOCK=0

# Optional: AI API Keys (for fallback functionality)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here