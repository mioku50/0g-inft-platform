# =============================================================================
# 0G INFT Platform Environment Configuration
# =============================================================================

# NEXT.JS
NEXT_PUBLIC_PROJECT_ID=your_walletconnect_project_id

# =============================================================================
# NETWORK CONFIGURATION - 0G Galileo Testnet v3
# =============================================================================

# Chain Configuration  
NEXT_PUBLIC_0G_CHAIN_ID=16601
NEXT_PUBLIC_0G_RPC_URL=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_OG_RPC=https://testnet-rpc.0g.ai

# =============================================================================
# CONTRACT ADDRESSES - 0G Galileo Testnet v3
# =============================================================================

# INFT Contract
NEXT_PUBLIC_INFT_CONTRACT_ADDRESS=0x90bc6C564923fa97bD7Bfc90CD909C3B7aed7A44

# Compute Contracts
NEXT_PUBLIC_COMPUTE_LEDGER_CONTRACT=0x1a85Dd32da10c170F4f138d082DDc496ab3E5BAa
NEXT_PUBLIC_COMPUTE_INFERENCE_CONTRACT=0x5299bd255B76305ae08d7F95B270A485c6b95D54
NEXT_PUBLIC_FINE_TUNING_SERVING_ADDRESS=0xda478Ccf5d534346A16b1475E4c2DecE0268B176

# =============================================================================
# COMPUTE CONFIGURATION - Non-custodial Mode
# =============================================================================

# Enable non-custodial inference (users pay from their wallets)
NEXT_PUBLIC_USE_NONCUSTODIAL_INFERENCE=true
USE_NONCUSTODIAL_INFERENCE=true

# Default provider for inference
NEXT_PUBLIC_FINE_TUNE_PROVIDER=0xf07240Efa67755B5311bc75784a061eDB47165Dd

# Fine-tune feature flags (set to false to disable)
ENABLE_FINE_TUNE=false
NEXT_PUBLIC_FT_DISABLED=1
FINE_TUNE_ENABLE_PREFLIGHT_CHECK=true
FINE_TUNE_MAX_CONCURRENT_REQUESTS=4
FINE_TUNE_REQUEST_DELAY_MS=200
FINE_TUNE_CACHE_TTL_MS=30000

# =============================================================================
# STORAGE CONFIGURATION - 0G Storage
# =============================================================================

# Storage endpoints
NEXT_PUBLIC_0G_STORAGE_ENDPOINT=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_0G_STORAGE_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
NEXT_PUBLIC_0G_STORAGE_KV_RPC=http://3.101.147.150:6789

# Storage Flow Contract
NEXT_PUBLIC_0G_STORAGE_FLOW_ADDRESS=0x3aa418cad6709482F2d92e55ed50EF39AA690C0a

# Storage Networks
NEXT_PUBLIC_STANDARD_FLOW_ADDRESS=0xbD75117F80b4E22698D0Cd7612d92BDb8eaff628
NEXT_PUBLIC_STANDARD_STORAGE_RPC=https://indexer-storage-testnet-turbo.0g.ai
NEXT_PUBLIC_STANDARD_EXPLORER_URL=https://chainscan-galileo.0g.ai/tx/
NEXT_PUBLIC_STANDARD_L1_RPC=https://evmrpc-testnet.0g.ai

NEXT_PUBLIC_TURBO_FLOW_ADDRESS=0xbD75117F80b4E22698D0Cd7612d92BDb8eaff628
NEXT_PUBLIC_TURBO_STORAGE_RPC=https://indexer-storage-testnet-turbo.0g.ai
NEXT_PUBLIC_TURBO_EXPLORER_URL=https://chainscan-galileo.0g.ai/tx/
NEXT_PUBLIC_TURBO_L1_RPC=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_DEFAULT_NETWORK=turbo

# =============================================================================
# SERVER-SIDE KEYS (ONLY FOR STORAGE OPERATIONS)
# =============================================================================

# Storage key for server-side operations (metadata, datasets)
OG_STORAGE_PRIVATE_KEY=your_storage_private_key_here

# Compute key NOT USED in non-custodial mode
# OG_COMPUTE_PRIVATE_KEY=not_needed_in_non_custodial_mode

# =============================================================================
# MARKETPLACE & FEATURES
# =============================================================================

# Marketplace (currently in sleep mode)
NEXT_PUBLIC_MARKETPLACE_ENABLED=false

# Agent Model Registry
NEXT_PUBLIC_AGENT_MODEL_REGISTRY_ADDRESS=

# =============================================================================
# DEVELOPMENT
# =============================================================================

# Local development
NODE_ENV=production