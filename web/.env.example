# 0G INFT Platform - Enhanced Environment Configuration
# Copy this file to .env.local and fill in your values

# =============================================
# NETWORK CONFIGURATION (Galileo Testnet v3)
# =============================================
NEXT_PUBLIC_0G_RPC_URL=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_RPC_URL=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_CHAIN_ID=16601
NEXT_PUBLIC_0G_CHAIN_ID=16601
NEXT_PUBLIC_DEFAULT_NETWORK=turbo

# Alternative RPC URLs (fallback)
# NEXT_PUBLIC_RPC_URL=https://rpc-testnet.0g.ai

# =============================================
# CONTRACT ADDRESSES (Galileo Testnet v3)
# =============================================
# INFT NFT Contracts
NEXT_PUBLIC_INFT_CONTRACT_ADDRESS=0x89e6d5De26F5f31E7f10598ec7E6FBA3C5FdbC8a
NEXT_PUBLIC_AGENT_MODEL_REGISTRY_ADDRESS=0x358d481AbFE7548EA8F3a806c675729910F29E4e

# 0G Compute Network Contracts  
NEXT_PUBLIC_FINE_TUNING_SERVING_ADDRESS=0xda478Ccf5d534346A16b1475E4c2DecE0268B176
NEXT_PUBLIC_COMPUTE_LEDGER_CONTRACT=0x1a85Dd32da10c170F4f138d082DDc496ab3E5BAa
NEXT_PUBLIC_COMPUTE_INFERENCE_CONTRACT=0x5299bd255B76305ae08d7F95B270A485c6b95D54

# =============================================
# 0G STORAGE CONFIGURATION
# =============================================
NEXT_PUBLIC_STANDARD_FLOW_ADDRESS=0xbD75117F80b4E22698D0Cd7612d92BDb8eaff628
NEXT_PUBLIC_STANDARD_STORAGE_RPC=https://indexer-storage-testnet-turbo.0g.ai
NEXT_PUBLIC_STANDARD_EXPLORER_URL=https://chainscan-galileo.0g.ai/tx/
NEXT_PUBLIC_STANDARD_L1_RPC=https://evmrpc-testnet.0g.ai

# Turbo Network Configuration
NEXT_PUBLIC_TURBO_FLOW_ADDRESS=0xbD75117F80b4E22698D0Cd7612d92BDb8eaff628
NEXT_PUBLIC_TURBO_STORAGE_RPC=https://indexer-storage-testnet-turbo.0g.ai
NEXT_PUBLIC_TURBO_EXPLORER_URL=https://chainscan-galileo.0g.ai/tx/
NEXT_PUBLIC_TURBO_L1_RPC=https://evmrpc-testnet.0g.ai

# 0G Storage URLs
NEXT_PUBLIC_0G_STORAGE_URL=https://storage-testnet.0g.ai
NEXT_PUBLIC_0G_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# =============================================
# 0G PROVIDERS & MODELS
# =============================================
# Official 0G Fine-tuning Provider (Llama 3.3 70B)
NEXT_PUBLIC_FINE_TUNE_PROVIDER=0xf07240Efa67755B5311bc75784a061eDB47165Dd

# Available Providers:
# Llama 3.3 70B Instruct: 0xf07240Efa67755B5311bc75784a061eDB47165Dd  
# DeepSeek R1 70B: 0x3feE5a4dd5FDb8a32dDA97Bed899830605dBD9D3

# =============================================
# PRIVATE KEYS (Server-side only)
# =============================================
# CRITICAL: Never expose these keys to the client-side!
# Get testnet ETH from: https://faucet.0g.ai

# For compute operations (inference, fine-tuning)
OG_COMPUTE_PRIVATE_KEY=your_private_key_here_without_0x_prefix

# For storage operations (metadata, datasets)
OG_STORAGE_PRIVATE_KEY=your_private_key_here_without_0x_prefix

# =============================================
# WALLET INTEGRATION
# =============================================
# WalletConnect Project ID (for client-side connections)
# Get from: https://cloud.walletconnect.com/
NEXT_PUBLIC_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# =============================================
# ENHANCED RATE LIMITING SETTINGS
# =============================================
# RPC Rate Limiting (Galileo Testnet v3: max 10 req/100ms)
RPC_MAX_CONCURRENT_REQUESTS=3
RPC_REQUEST_DELAY_MS=120
RPC_BATCH_DELAY_MS=150
RPC_MAX_RETRIES=5
RPC_INITIAL_BACKOFF_MS=100

# Chat API Rate Limiting
CHAT_RATE_LIMIT_PER_MINUTE=30

# Metadata Sync Rate Limiting  
METADATA_SYNC_BATCH_SIZE=5
METADATA_SYNC_DELAY_MS=2000
METADATA_SYNC_TOKEN_DELAY_MS=500

# Cache TTL Settings (milliseconds)
PROVIDER_ACK_CACHE_TTL=1800000  # 30 minutes
BROKER_CACHE_TTL=600000         # 10 minutes
SERVICE_CACHE_TTL=300000        # 5 minutes

# =============================================
# FEATURE FLAGS
# =============================================
# Core Features
NEXT_PUBLIC_FT_DISABLED=0               # Set to 1 to disable fine-tuning
NEXT_PUBLIC_MARKETPLACE_ENABLED=1       # Enable marketplace
NEXT_PUBLIC_FINE_TUNING_ENABLED=1       # Enable fine-tuning  
NEXT_PUBLIC_CHAT_ENABLED=1              # Enable chat functionality

# Enhanced Features
ENHANCED_INFERENCE=1                    # Enhanced inference with rate limiting
ENHANCED_STABLE=1                       # Mark enhanced features as production ready

# Debug Modes (set to 1 to enable detailed logging)
DEBUG_RPC_CALLS=0
DEBUG_STORAGE_CALLS=0  
DEBUG_CHAT_VERBOSE=0
DEBUG_RATE_LIMITING=0

# =============================================
# ORACLE CONFIGURATION (Optional)
# =============================================
ORACLE_TEE_SERVICE_URL=http://localhost:3001
NEXT_PUBLIC_ORACLE_MODE=mock

# =============================================
# ADVANCED CONFIGURATION
# =============================================
# Request timeouts (milliseconds)
CHAT_REQUEST_TIMEOUT=25000
PROVIDER_TIMEOUT=20000
BROKER_INIT_TIMEOUT=15000

# Error handling
SOFT_ERROR_MODE=1                       # Use warnings instead of hard throws
FALLBACK_RESPONSES=1                    # Enable fallback responses on errors

# =============================================
# EXTERNAL SERVICES (Optional)
# =============================================
# Only needed for additional AI capabilities
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# =============================================
# MONITORING & ANALYTICS (Optional) 
# =============================================
# SENTRY_DSN=your_sentry_dsn_here
# GOOGLE_ANALYTICS_ID=your_ga_id_here

# =============================================
# QUICK SETUP GUIDE
# =============================================
# 1. Get testnet ETH: https://faucet.0g.ai
# 2. Copy your private key (without 0x) to OG_COMPUTE_PRIVATE_KEY and OG_STORAGE_PRIVATE_KEY  
# 3. Get WalletConnect Project ID: https://cloud.walletconnect.com/
# 4. Add Galileo Testnet v3 to your wallet:
#    - Network Name: 0G Galileo Testnet v3
#    - RPC URL: https://evmrpc-testnet.0g.ai
#    - Chain ID: 16601
#    - Currency Symbol: OG
#    - Block Explorer: https://chainscan-galileo.0g.ai

# =============================================
# TROUBLESHOOTING RATE LIMITS
# =============================================
# If you see "request rate exceeded" errors:
# 1. Increase RPC_REQUEST_DELAY_MS to 200-300
# 2. Decrease RPC_MAX_CONCURRENT_REQUESTS to 2 or 1
# 3. Increase RPC_BATCH_DELAY_MS to 200-300
# 4. Try alternative RPC URLs

# Common error fixes:
# - "missing revert data": Usually network congestion, retry automatically handled
# - "Provider not responding": Check provider addresses and network connectivity
# - "Insufficient balance": Add testnet ETH to your wallet

