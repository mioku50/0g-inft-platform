# web/.env.local - Правильная конфигурация для 0G

# 0G Network Configuration
NEXT_PUBLIC_0G_RPC_URL=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_0G_CHAIN_ID=16601

# 0G Services URLs (indexer endpoints)
NEXT_PUBLIC_0G_STORAGE_URL=https://indexer-storage-testnet-turbo.0g.ai

# Contract Addresses
NEXT_PUBLIC_INFT_CONTRACT_ADDRESS=0x53c92E4fba02D2eBB9D78E1d4913289defFea7f6
NEXT_PUBLIC_MARKETPLACE_CONTRACT_ADDRESS=0xC68650eCbFd6A2a8e93E6D05Df6e4d404F01C8d5
NEXT_PUBLIC_ORACLE_CONTRACT_ADDRESS=0x8EBf5b9C599e77d44AE6A5A5f4E3dCAE935651cF
NEXT_PUBLIC_0G_FLOW_ADDRESS=0xbD75117F80b4E22698D0Cd7612d92BDb8eaff628  # Flow contract для storage

# Private Keys (НЕ коммитьте в git!)
# Для Storage - кошелек для оплаты транзакций загрузки
OG_STORAGE_PRIVATE_KEY=0x60d6657135c7a050f5a326a93f39ded3a0295b6f70b28ce75f1e5d69f95bfe65

# Для Compute - кошелек для ledger и оплаты AI запросов  
OG_COMPUTE_PRIVATE_KEY=0x60d6657135c7a050f5a326a93f39ded3a0295b6f70b28ce75f1e5d69f95bfe65

# Optional: IPFS для изображений
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
PINATA_API_KEY=  # Если используете Pinata для изображений
PINATA_SECRET_KEY=

# ===================================
# contracts/.env - для деплоя контрактов

# Private key для деплоя (без 0x префикса)
PRIVATE_KEY=0x60d6657135c7a050f5a326a93f39ded3a0295b6f70b28ce75f1e5d69f95bfe65

# 0G Network RPC
OG_RPC_URL=https://evmrpc-testnet.0g.ai

# ===================================
# ВАЖНО:
# 1. В 0G НЕТ API ключей - все работает через приватные ключи кошельков
# 2. Storage оплачивается через транзакции к Flow контракту
# 3. Compute использует ledger систему с предоплатой
# 4. Используйте РАЗНЫЕ кошельки для разных целей (безопасность)
# 5. Пополните кошельки тестовыми A0GI токенами из faucet: https://faucet.0g.ai