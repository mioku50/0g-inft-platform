{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@0glabs/0g-serving-broker/plugins/tasks": ["./lib/compute/broker-plugins/tasks"],
      "@0glabs/0g-serving-broker/plugins/inference": ["./lib/compute/broker-plugins/inference"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "tests",
    "lib/0g-compute-ts-starter-kit/**/*",
    "lib/0g-serving-broker/**/*",
    "lib/0g-serving-contract/**/*",
    "lib/0g-serving-user-broker/**/*",
    "scripts/claude-debug.ts"
  ]
}
